# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~
.history/

# Claude Code — local-user state stays out of version control.
# .claude/settings.json and .claude/commands/ are project-shared and may
# be committed; this only excludes the per-user pieces.
.claude/settings.local.json
.claude/.session/
.claude/todos/
.claude/shell-snapshots/
.claude/statsig/
.claude/projects/
.claude/history.jsonl

# Misc
.cache/
/coverage/
*.tsbuildinfo

# Design source masters — large PNG plates exported from Blender / Affinity.
# Kept OUTSIDE static/ so SvelteKit never copies them into the build output;
# the optimize-* scripts read from here and write committed AVIF/WebP tiers into
# static/. The masters themselves are local-only (regenerable from source files).
/assets-src/

# Scratch / generated artifacts — regenerable, not a source of truth
# scratch/ is where throwaway verification scripts go (CLAUDE.md § Verification
# Policy) — written, run, reported, deleted in the same turn. Never committed.
scratch/
claude-artifacts/
probe-*.png
frame-rework-*.png

# Testing — headless-browser verification output
test-results/
playwright-report/
playwright/.cache/

# Probe screenshot output (probes default SHOTS_DIR to the repo root)
/*.png
