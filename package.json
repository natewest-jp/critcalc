{
	"name": "critcalc",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"predev": "node scripts/generate-newfit.js && node scripts/generate-character-roles.mjs && node scripts/generate-character-index.mjs && node scripts/generate-element-icons.mjs && node scripts/generate-marks.mjs && node scripts/generate-constellation-marks.mjs && node scripts/generate-fingerprint-glyphs.mjs",
		"dev": "vite dev",
		"prebuild": "node scripts/generate-newfit.js && node scripts/generate-character-roles.mjs && node scripts/generate-character-index.mjs && node scripts/generate-element-icons.mjs && node scripts/generate-marks.mjs && node scripts/generate-constellation-marks.mjs && node scripts/generate-fingerprint-glyphs.mjs",
		"build": "vite build",
		"preview": "vite preview",
		"optimize-bg": "node scripts/optimize-bg.js",
		"audit-scene-plate": "node scripts/audit-scene-plate.mjs",
		"optimize-portal": "node scripts/optimize-portal.js",
		"build-logo": "node scripts/build-logo.mjs",
		"generate-newfit": "node scripts/generate-newfit.js",
		"generate-stars": "node scripts/generate-stars.js",
		"generate-character-index": "node scripts/generate-character-index.mjs",
		"generate-element-icons": "node scripts/generate-element-icons.mjs",
		"generate-character-roles": "node scripts/generate-character-roles.mjs",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "npm run test:e2e:chrome; npm run test:e2e:webkit",
		"test:e2e:chrome": "playwright test --project=chrome --grep-invert @storm",
		"test:e2e:webkit": "playwright test --project=webkit --grep-invert @storm",
		"test:e2e:ui": "playwright test --project=chrome --ui",
		"test:e2e:storm": "playwright test --grep @storm --workers=1 --retries=0",
		"test:e2e:report": "playwright show-report",
		"generate-marks": "node scripts/generate-marks.mjs",
		"generate-con-marks": "node scripts/generate-constellation-marks.mjs",
		"generate-fingerprint": "node scripts/generate-fingerprint-glyphs.mjs"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.2",
		"@eslint/js": "^9.39.2",
		"@playwright/test": "^1.61.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/node": "^24",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.14.0",
		"genshin-db": "^5.2.14",
		"globals": "^17.3.0",
		"jsonc-parser": "^3.3.1",
		"lucide": "^1.30.0",
		"playwright": "^1.61.1",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"sharp": "^0.34.5",
		"svelte": "^5.49.2",
		"svelte-check": "^4.3.6",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.54.0",
		"vite": "^7.3.1",
		"vitest": "^4.1.5"
	},
	"dependencies": {
		"@codemirror/autocomplete": "^6.20.1",
		"@codemirror/commands": "^6.10.3",
		"@codemirror/state": "^6.6.0",
		"@codemirror/view": "^6.41.0",
		"@fontsource-variable/bitter": "^5.2.10",
		"@fontsource-variable/ibm-plex-sans": "^5.3.0",
		"@fontsource/ibm-plex-mono": "^5.2.7",
		"@fontsource/ibm-plex-sans": "^5.2.8",
		"@fontsource/ibm-plex-sans-condensed": "^5.2.8",
		"bits-ui": "^2.16.0"
	}
}
