# ============================================================
# ⚠️  AT FULL LAUNCH (target: 2026-08-11): delete ONLY the
# X-Robots-Tag rule below to re-enable search indexing.
# The Cache-Control rules further down are permanent — keep them.
# ============================================================
/*
  X-Robots-Tag: noindex
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# The HTML shell must NOT be held. Cloudflare Pages' default for non-hashed
# assets is 4h must-revalidate, which would pin a user to a stale shell for
# hours after a fix ships — exactly wrong in the weeks after launch, when
# fixes land in response to user reports. The shell is small; revalidating it
# every navigation costs a conditional request and buys immediate rollout.
# (Assets it references are content-hashed and immutable, below.)
/
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Static art/icons are ADD-ONLY: a changed asset must ship under a NEW
# filename (e.g. -newfit variants), never edited in place — browsers hold
# these for a year. Overrides Cloudflare Pages' default 4h must-revalidate,
# which re-ran ~126 conditional requests per portrait grid after every
# cache expiry or deploy.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# SvelteKit content-hashed build output — canonically immutable.
/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable
