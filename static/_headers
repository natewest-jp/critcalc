# ============================================================
# ✅ LAUNCHED 2026-10-19: the X-Robots-Tag: noindex rule that
# kept the site out of search until launch is gone. The
# Cache-Control rules further down are permanent — keep them.
# ============================================================
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# The not-found shell (adapter-static's fallback) is a real file, so a direct
# visit to /404 answers 200, and the shell has no head of its own to say
# noindex in. Unknown paths get a real 404 status and need no rule.
/404
  X-Robots-Tag: noindex
/404.html
  X-Robots-Tag: noindex

# The translated locales ship unlinked and out of search until Nate opens
# each one (src/lib/i18n/locale.ts § isIndexed). Every page already says
# noindex in its head; this says it for anything that reads only headers.
# Opening a locale removes its two rules here.
/ja
  X-Robots-Tag: noindex
/ja/*
  X-Robots-Tag: noindex
/zh
  X-Robots-Tag: noindex
/zh/*
  X-Robots-Tag: noindex
# The pseudo-locale (src/lib/i18n/pseudo.ts) is never opened.
/en-XA
  X-Robots-Tag: noindex
/en-XA/*
  X-Robots-Tag: noindex

# The HTML shell must NOT be held. Cloudflare Pages' default for non-hashed
# assets is 4h must-revalidate, which would pin a user to a stale shell for
# hours after a fix ships — exactly wrong in the weeks after launch, when
# fixes land in response to user reports. The shell is small; revalidating it
# every navigation costs a conditional request and buys immediate rollout.
# (Assets it references are content-hashed and immutable, below.)
/
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Static art/icons are ADD-ONLY: a changed asset must ship under a NEW
# filename (e.g. -newfit variants), never edited in place — browsers hold
# these for a year. Overrides Cloudflare Pages' default 4h must-revalidate,
# which re-ran ~126 conditional requests per portrait grid after every
# cache expiry or deploy.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# SvelteKit content-hashed build output — canonically immutable.
/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable
